{
  "name": "taskflow-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:local": "cross-env NODE_ENV=local nest start --watch",
    "start:dev": "cross-env NODE_ENV=dev node dist/main",
    "start:prod": "cross-env NODE_ENV=prod node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "node ./node_modules/typeorm/cli.js",
    "typeorm:migrate": "npm run typeorm -- migration:run -d ./dist/data-source.js",
    "typeorm:generate": "npm run typeorm -- migration:generate -d ./dist/data-source.js",
    "typeorm:revert": "npm run typeorm -- migration:revert -d ./dist/data-source.js",
    "typeorm:local": "cross-env DOTENV_CONFIG_PATH=.local.env ts-node -r dotenv/config --files ./node_modules/typeorm/cli.js",
    "typeorm:local:create": "npm run typeorm:local -- migration:create",
    "typeorm:local:generate": "npm run typeorm:local -- migration:generate ./src/migrations/$npm_config_name -d ./src/data-source.ts",
    "typeorm:local:migrate": "npm run typeorm:local -- migration:run -d ./src/data-source.ts",
    "typeorm:local:revert": "npm run typeorm:local -- migration:revert -d ./src/data-source.ts",
    "backfill:schedule-holidays": "cross-env DOTENV_CONFIG_PATH=.local.env ts-node -r dotenv/config -r tsconfig-paths/register src/schedule/backfill-schedule-holidays.ts",
    "backfill:schedule-holidays:write": "npm run backfill:schedule-holidays -- --write"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.1.0",
    "googleapis": "^153.0.0",
    "ioredis": "^5.8.2",
    "joi": "^17.13.3",
    "marked": "^17.0.1",
    "multer": "^2.2.0",
    "node-ical": "^0.26.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ssh2-sftp-client": "^12.0.1",
    "typeorm": "^0.3.25",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "multer": "$multer"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
