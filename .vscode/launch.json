{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:debug",
        "--",
        "--inspect-brk"
      ],
      "env": {
        "NODE_ENV": "local"
      },
      "console": "integratedTerminal",
      "restart": true,
      "autoAttachChildProcesses": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "dev",
      "program": "${workspaceFolder}/dist/main.js",
      "runtimeArgs": [
        "--inspect-brk"
      ],
      "env": {
        "NODE_ENV": "dev"
      },
      "console": "integratedTerminal",
      "restart": false,
      "autoAttachChildProcesses": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "prod",
      "program": "${workspaceFolder}/dist/main.js",
      "runtimeArgs": [
        "--inspect-brk"
      ],
      "env": {
        "NODE_ENV": "prod"
      },
      "console": "integratedTerminal",
      "restart": false,
      "autoAttachChildProcesses": true
    }
  ]
}